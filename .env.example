# Key GLEE sends in the X-API-Key header (leave empty to run without authentication)
GLEE_KEY=

# Optional: an OpenAI-compatible model for message wording and reading free-text seller messages.
# Without LLM_API_KEY the agent runs fully offline with template messages.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
